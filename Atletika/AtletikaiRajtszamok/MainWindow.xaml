<Window x:Class="AtletikaiRajtszamok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlétikai verseny - Rajtszámok"
        Width="1240" Height="820"
        Background="#F3F6FA"
        FontFamily="Segoe UI" FontSize="14">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <DockPanel LastChildFill="True">

                <Button x:Name="btnRegisztral" DockPanel.Dock="Bottom"
                        Content="REGISZTRÁL" Height="36" Background="#DDEBFA"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Margin="0,12,0,0" Click="Regisztral_Click"/>

                <StackPanel>
                    <TextBlock Text="Új versenyző" FontSize="22" FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,12"/>

                    <TextBlock Text="Versenyző neve:" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNev" Height="32"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Versenyszám:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbVersenyszam" Height="32" IsEditable="False"
                              SelectedIndex="-1" VerticalContentAlignment="Center"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="100 m"/>
                        <ComboBoxItem Content="200 m"/>
                        <ComboBoxItem Content="400 m"/>
                        <ComboBoxItem Content="800 m"/>
                        <ComboBoxItem Content="1500 m"/>
                        <ComboBoxItem Content="Távolugrás"/>
                        <ComboBoxItem Content="Magasugrás"/>
                        <ComboBoxItem Content="Súlylökés"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Nem:" VerticalAlignment="Center" Width="60"/>
                        <RadioButton x:Name="rbFerfi" Content="Férfi" GroupName="Nem"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,40,0"/>
                        <RadioButton x:Name="rbNo" Content="Nő" GroupName="Nem"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Életkor:" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtEletkor" Grid.Column="1" Text="18 év"
                                   FontWeight="Bold" Foreground="#1F5C99"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Grid>
                    <Slider x:Name="sldEletkor" Minimum="18" Maximum="90" Value="18"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            ValueChanged="Eletkor_Valtozott" Margin="8,4,8,0"/>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="18" Foreground="#52657A" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock Text="90" Foreground="#52657A" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    </Grid>

                    <TextBlock Text="Korábbi eredmények" FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,6"/>
                    <CheckBox x:Name="chkOlimpiai" Content="Olimpiai csúcs" Margin="0,0,0,6"/>
                    <CheckBox x:Name="chkVB" Content="Világbajnoki csúcs" Margin="0,0,0,6"/>
                    <CheckBox x:Name="chkEB" Content="Európa-bajnoki csúcs" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Igényelt rajtszám:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="txtRajtszam" Grid.Column="1" Height="32"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                    </Grid>
                    <TextBlock Text="Üres mező: automatikus kiosztás." Foreground="#52657A" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Regisztrált versenyzők" FontSize="22" FontWeight="Bold"
                           Foreground="#19324D" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="1" Text="Rajtszám | Név | Versenyszám | Nem | Kor | O | VB | EB"
                           Foreground="#52657A" Margin="0,0,0,10"/>
                <ListBox x:Name="lstVersenyzok" Grid.Row="2" Padding="6" BorderBrush="#D4DDE7"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="3" Text="O = olimpiai, VB = világbajnoki, EB = Európa-bajnoki csúcs"
                           Foreground="#52657A" FontSize="12" Margin="0,12,0,0"/>
            </Grid>
        </Border>


        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtLetszam" Grid.Column="0" Text="Regisztrált versenyzők: 0"
                           Foreground="#52657A" VerticalAlignment="Center"/>
                <Button x:Name="btnMentes" Grid.Column="1" Content="FÁJLBA MENTÉS"
                        Width="210" Height="32" VerticalContentAlignment="Center"
                        Click="Mentes_Click"/>
                <Button x:Name="btnBetoltes" Grid.Column="2" Content="FÁJLBÓL BETÖLTÉS"
                        Width="210" Height="32" VerticalContentAlignment="Center"
                        Margin="16,0,0,0" Click="Betoltes_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
